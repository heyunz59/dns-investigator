[
  {
    "tool": "query_dns",
    "match": {
      "domain": "example.com",
      "record_type": "A"
    },
    "data": {
      "rcode": "NOERROR",
      "records": [
        {
          "value": "192.0.2.10",
          "ttl": 60
        }
      ],
      "resolvers": [
        "192.0.2.53"
      ],
      "record_type": "A"
    }
  },
  {
    "tool": "check_tcp",
    "match": {
      "ip": "192.0.2.10",
      "port": 443
    },
    "data": {
      "ip": "192.0.2.10",
      "port": 443,
      "status": "CONNECTED"
    }
  },
  {
    "tool": "check_http",
    "match": {
      "url": "https://example.com/"
    },
    "data": {
      "status_code": 200,
      "final_url": "https://example.com/",
      "redirects": [],
      "peer_ip": null,
      "proxy_mode": "fixture",
      "error": null
    }
  }
]
